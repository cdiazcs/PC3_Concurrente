# Sustituir nombres por MagicDNS o IP reales de tailscale ip -4.
# Estos nombres son marcadores de ejemplo; no representan nodos existentes.
INFERENCE_TRANSPORT=RABBITMQ
BACKEND_HOST=nodo-backend.example
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=9000
WORKER_JAVA_HOST=nodo-backend.example
WORKER_JAVA_PORT=9101
WORKER_PYTHON_HOST=nodo-ia.example
WORKER_PYTHON_PORT=9102
WORKER_CSHARP_HOST=nodo-clientes.example
WORKER_CSHARP_PORT=9103
RABBITMQ_HOST=nodo-backend.example
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
POSTGRES_ENABLED=false
POSTGRES_HOST=nodo-backend.example
POSTGRES_PORT=5432
POSTGRES_DB=pc3_concurrente
POSTGRES_USER=
POSTGRES_PASSWORD=
MARIADB_HOST=nodo-clientes.example
MARIADB_PORT=3306
MARIADB_DATABASE=pc3_bd2
MARIADB_USER=
MARIADB_PASSWORD=
HTTP_BIND_HOST=127.0.0.1
HTTP_PORT=8080
WEB_GW_HOST=127.0.0.1
WEB_GW_PORT=8080
# Timeouts en ms; CLIENT debe ser mayor que RABBITMQ_REQUEST.
BACKEND_WORKER_TIMEOUT_MS=10000
BACKEND_IDENTIFY_TIMEOUT_MS=12000
BACKEND_CLIENT_TIMEOUT_MS=30000
CLIENT_TIMEOUT_MS=30000
RABBITMQ_REQUEST_TIMEOUT_MS=25000
RABBITMQ_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_CONNECT_TIMEOUT_MS=5000
RABBITMQ_HEARTBEAT=60
IA_PROCESSING_TIMEOUT_SECONDS=10
IA_MAX_ATTEMPTS=3
IA_RETRY_MS=1000
INFERENCE_MODE=SEQUENTIAL
PC3_WORKER_TIMEOUT_MS=15000
PC3_WORKER_MAX_CLIENTS=64
