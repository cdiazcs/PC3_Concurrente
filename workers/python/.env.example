RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=REPLACE_WITH_SCOPED_USER
RABBITMQ_PASSWORD=REPLACE_OUTSIDE_SOURCE_CONTROL
IA_MODEL_NAME=A
IA_WORKER_ID=ia-A
IA_WORKER_CONCURRENCY=2
IA_PREFETCH=1
IA_REQUEST_QUEUE=cola_modeloA
IA_RESULT_QUEUE=cola_resultadosA
IA_RETRY_QUEUE=cola_modeloA.ia_retry
IA_ERROR_QUEUE=cola_modeloA.ia_errores
IA_MAX_ATTEMPTS=3
IA_RETRY_MS=1000
IA_PROCESSING_TIMEOUT_SECONDS=10
RABBITMQ_HEARTBEAT=60
IA_CACHE_SIZE=4096
IA_CACHE_TTL_SECONDS=3600
# Optional, only for requests with payload.modo=DISTRIBUTED; requires approved internal TCP deployment:
# IA_COORDINATOR_HOST=localhost
# IA_COORDINATOR_PORT=9000
# IA_WEIGHTS=model/weights/weights.txt
# IA_METRICS_FILE=build/phase3/ia-events.jsonl
# Optional domain control queues; enable only after topology agreement:
IA_PUBLISH_CONTROL=0
IA_CONTROL_QUEUE=cola_control_heartbeat
IA_LOG_QUEUE=cola_logs
